@model UretimERP.Models.MusteriDetayViewModel

@{
    ViewBag.Title = "Müşteri Detayı";
}
<div class="page-header">
    <div>
        <h2>Müşteri Detayı</h2>
        <p>@Model.CariKod numaralı müşterinin cari bilgileri</p>
    </div>

    <a href="@Url.Action("Index", "Musteri")" class="back-button">
        ← Müşterilere Dön
    </a>
</div>

<div class="customer-info-grid">

    <div class="info-card">
        <span>Cari Kod</span>
        <strong>@Model.CariKod</strong>
    </div>

    <div class="info-card">
        <span>Firma</span>
        <strong>@Model.FirmaAdi</strong>
    </div>

    <div class="info-card">
        <span>Yetkili</span>
        <strong>@Model.YetkiliAdi</strong>
    </div>

    <div class="info-card">
        <span>Telefon</span>
        <strong>@Model.Telefon</strong>
    </div>

    <div class="info-card">
        <span>E-posta</span>
        <strong>@Model.Email</strong>
    </div>

    <div class="info-card">
        <span>Durum</span>
        <strong>@(Model.AktifMi ? "Aktif" : "Pasif")</strong>
    </div>

</div>

<div class="customer-summary">

    <div class="summary-card">
        <span>Toplam Sipariş</span>
        <strong>@Model.SiparisSayisi</strong>
        <small>Müşteriye ait sipariş sayısı</small>
    </div>

    <div class="summary-card">
        <span>Toplam Alacak</span>
        <strong>@Model.ToplamAlacak.ToString("N2")</strong>
        <small>Müşteri alacak kayıtları</small>
    </div>

    <div class="summary-card">
        <span>Toplam Tahsilat</span>
        <strong>@Model.ToplamTahsilat.ToString("N2")</strong>
        <small>Müşteriden yapılan tahsilatlar</small>
    </div>

</div>
<div class="customer-orders">

    <div class="section-header">
        <div>
            <h3>Müşteri Siparişleri</h3>
            <p>Bu müşteriye ait sipariş geçmişi</p>
        </div>
    </div>

    <table class="customer-orders-table">
        <thead>
            <tr>
                <th>Sipariş No</th>
                <th>Sipariş Tarihi</th>
                <th>Termin Tarihi</th>
                <th>Durum</th>
                <th>İşlem</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Siparisler != null && Model.Siparisler.Any())
            {
                foreach (var siparis in Model.Siparisler)
                {
                    <tr>
                        <td>
                            <strong>@siparis.SiparisNo</strong>
                        </td>

                        <td>
                            @siparis.SiparisTarihi.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @(siparis.TerminTarihi.HasValue
        ? siparis.TerminTarihi.Value.ToString("dd.MM.yyyy")
        : "-")
                        </td>

                        <td>
                            <span class="order-status">
                                @siparis.Durum
                            </span>
                        </td>
                        <td>
                            <a href="@Url.Action("Detay", "Siparis", new { id = siparis.SiparisID })"
                               class="order-detail-button">
                                Detay →
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="empty-orders">
                        Bu müşteriye ait sipariş bulunmuyor.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }

        .page-header h2 {
            margin: 0 0 5px;
            font-size: 24px;
        }

        .page-header p {
            margin: 0;
            color: #87938c;
            font-size: 12px;
        }

    .back-button {
        padding: 9px 14px;
        border: 1px solid #dce5df;
        border-radius: 9px;
        background: #fff;
        color: #174d32;
        text-decoration: none;
        font-size: 12px;
    }

    .customer-info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 18px;
    }

    .info-card {
        background: #fff;
        border: 1px solid #edf1ee;
        border-radius: 14px;
        padding: 18px;
        min-height: 75px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .info-card span,
        .summary-card span {
            color: #89958e;
            font-size: 11px;
            margin-bottom: 8px;
        }

        .info-card strong {
            font-size: 13px;
        }

    .customer-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .summary-card {
        background: #fff;
        border: 1px solid #edf1ee;
        border-radius: 14px;
        padding: 20px 18px;
        display: flex;
        flex-direction: column;
    }

        .summary-card strong {
            font-size: 22px;
            margin-bottom: 7px;
        }

        .summary-card small {
            color: #9aa59e;
            font-size: 11px;
        }
    .customer-orders {
        margin-top: 18px;
        background: #fff;
        border: 1px solid #edf1ee;
        border-radius: 14px;
        padding: 18px;
    }

    .section-header {
        margin-bottom: 15px;
    }

        .section-header h3 {
            margin: 0 0 4px;
            font-size: 15px;
        }

        .section-header p {
            margin: 0;
            color: #929d97;
            font-size: 11px;
        }

    .customer-orders-table {
        width: 100%;
        border-collapse: collapse;
    }

        .customer-orders-table th {
            padding: 11px 10px;
            text-align: left;
            color: #7f8b84;
            font-size: 10px;
            font-weight: 600;
            border-bottom: 1px solid #e8edea;
        }

        .customer-orders-table td {
            padding: 13px 10px;
            font-size: 11px;
            border-bottom: 1px solid #edf1ee;
        }

    .order-status {
        display: inline-block;
        padding: 5px 9px;
        background: #edf5f0;
        color: #174d32;
        border-radius: 20px;
        font-size: 10px;
    }

    .order-detail-button {
        display: inline-block;
        padding: 7px 11px;
        border: 1px solid #d8e3dc;
        border-radius: 8px;
        background: #f8fbf9;
        color: #174d32;
        text-decoration: none;
        white-space: nowrap;
    }

        .order-detail-button:hover {
            background: #edf5f0;
            color: #174d32;
            text-decoration: none;
        }

    .empty-orders {
        text-align: center;
        color: #929d97;
        padding: 25px !important;
    }
</style>