@model IEnumerable<UretimERP.Models.MusteriListeViewModel>

@{
    ViewBag.Title = "Müşteriler";
}

<div class="page-header">
    <div>
        <h2>Müşteriler</h2>
        <p>Müşteri ve cari bilgilerini görüntüleyin.</p>
    </div>
</div>

<div class="customer-card">

    <table class="customer-table">
        <thead>
            <tr>
                <th>Cari Kod</th>
                <th>Firma</th>
                <th>Yetkili</th>
                <th>Telefon</th>
                <th>E-posta</th>
                <th>Durum</th>
                <th>İşlem</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var musteri in Model)
                {
                    <tr>
                        <td>
                            <strong>@musteri.CariKod</strong>
                        </td>

                        <td>@musteri.FirmaAdi</td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(musteri.YetkiliAdi))
                            {
                                @musteri.YetkiliAdi
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(musteri.Telefon))
                            {
                                @musteri.Telefon
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(musteri.Email))
                            {
                                @musteri.Email
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <td>
                            @if (musteri.AktifMi)
                            {
                                <span class="status-active">Aktif</span>
                            }
                            else
                            {
                                <span class="status-passive">Pasif</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("Detay", "Musteri", new { id = musteri.MusteriID })"
                               class="detail-button">
                                Detay →
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="empty-message">
                        Henüz müşteri kaydı bulunmuyor.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

<style>
    .page-header {
        margin-bottom: 20px;
    }

        .page-header h2 {
            margin: 0;
            font-size: 21px;
        }

        .page-header p {
            margin: 5px 0 0;
            font-size: 11px;
            color: #8a928c;
        }

    .customer-card {
        background: white;
        border-radius: 14px;
        padding: 20px;
    }

    .customer-table {
        width: 100%;
        border-collapse: collapse;
    }

        .customer-table th {
            text-align: left;
            padding: 11px;
            font-size: 10px;
            color: #8a928c;
            border-bottom: 1px solid #edf0ed;
        }

        .customer-table td {
            padding: 14px 11px;
            font-size: 11px;
            color: #3f4942;
            border-bottom: 1px solid #f0f2f0;
        }

    .status-active,
    .status-passive {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 600;
    }

    .status-active {
        background: #edf7f0;
        color: #356143;
    }

    .status-passive {
        background: #f3f3f3;
        color: #818781;
    }

    .empty-message {
        text-align: center !important;
        padding: 30px !important;
        color: #929a94 !important;
    }
    .detail-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 13px;
        border: 1px solid #d8e3dc;
        border-radius: 8px;
        background: #f8fbf9;
        color: #174d32;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
        transition: 0.2s ease;
    }

        .detail-button:hover {
            background: #edf5f0;
            border-color: #c8d9ce;
            color: #123d28;
            text-decoration: none;
        }
</style>