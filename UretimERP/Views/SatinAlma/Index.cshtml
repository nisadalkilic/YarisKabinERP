@model IEnumerable<UretimERP.Models.SatinAlmaListeViewModel>

@{
    ViewBag.Title = "Satın Alma";
}

<div class="page-header">
    <div>
        <h2>Satın Alma Siparişleri</h2>
        <p>Tedarikçilere verilen satın alma siparişlerini takip edin.</p>
    </div>
</div>

<div class="purchase-summary">

    <div class="summary-card">
        <span>Toplam Satın Alma</span>
        <strong>@ViewBag.ToplamSatinAlma</strong>
        <small>Tüm satın alma siparişleri</small>
    </div>

    <div class="summary-card">
        <span>Açık Sipariş</span>
        <strong>@ViewBag.AcikSatinAlma</strong>
        <small>Henüz kapanmamış siparişler</small>
    </div>

    <div class="summary-card">
        <span>Onay Bekleyen</span>
        <strong>@ViewBag.Bekleyen</strong>
        <small>Taslak satın alma siparişleri</small>
    </div>

    <div class="summary-card">
        <span>Tamamlanan</span>
        <strong>@ViewBag.Tamamlanan</strong>
        <small>Tamamlanmış satın almalar</small>
    </div>

</div>

<div class="purchase-card">

    <table class="purchase-table">
        <thead>
            <tr>
                <th>Sipariş No</th>
                <th>Tedarikçi</th>
                <th>Sipariş Tarihi</th>
                <th>Beklenen Teslim</th>
                <th>Durum</th>
                <th>İşlem</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var satinAlma in Model)
                {
                    <tr>
                        <td>
                            <strong>@satinAlma.SiparisNo</strong>
                        </td>

                        <td>@satinAlma.TedarikciAdi</td>

                        <td>
                            @satinAlma.SiparisTarihi.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @if (satinAlma.TerminTarihi.HasValue)
                            {
                                @satinAlma.TerminTarihi.Value.ToString("dd.MM.yyyy")
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <td>
                            <span class="purchase-status">
                                @satinAlma.Durum
                            </span>
                        </td>
                        <td>
                            <a href="@Url.Action("Detay", "SatinAlma", new { id = satinAlma.SatinAlmaSiparisID })"
                               class="detail-button">
                                Detay →
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="empty-message">
                        Henüz satın alma siparişi bulunmuyor.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .page-header h2 {
            margin: 0;
            font-size: 21px;
        }

        .page-header p {
            margin: 5px 0 0;
            font-size: 11px;
            color: #8a928c;
        }

    .purchase-card {
        background: white;
        border-radius: 14px;
        padding: 20px;
    }

    .purchase-table {
        width: 100%;
        border-collapse: collapse;
    }

        .purchase-table th {
            text-align: left;
            padding: 11px;
            font-size: 10px;
            color: #8a928c;
            border-bottom: 1px solid #edf0ed;
        }

        .purchase-table td {
            padding: 14px 11px;
            font-size: 11px;
            color: #3f4942;
            border-bottom: 1px solid #f0f2f0;
        }

    .purchase-status {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        background: #eef5f0;
        color: #42604a;
        font-size: 9px;
        font-weight: 600;
    }

    .empty-message {
        text-align: center !important;
        padding: 30px !important;
        color: #929a94 !important;
    }

    .detail-button {
        display: inline-block;
        padding: 7px 11px;
        border: 1px solid #dfe8e1;
        border-radius: 8px;
        background: #f7faf8;
        color: #315c3d;
        text-decoration: none;
        font-size: 10px;
        font-weight: 600;
    }

        .detail-button:hover {
            background: #edf6ef;
            color: #174b2d;
        }

    .purchase-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 18px;
    }

    .summary-card {
        background: #fff;
        border: 1px solid #edf1ee;
        border-radius: 14px;
        padding: 22px 18px;
        min-height: 105px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .summary-card span {
            font-size: 12px;
            color: #7d8b82;
            margin-bottom: 10px;
        }

        .summary-card strong {
            font-size: 24px;
            margin-bottom: 8px;
        }

        .summary-card small {
            font-size: 11px;
            color: #9aa59e;
        }
</style>
