@model IEnumerable<UretimERP.Models.SiparisListeViewModel>

@{
    ViewBag.Title = "Siparişler";
}

<div class="page-header">
    <div>
        <h2>Siparişler</h2>
        <p>Müşteri siparişlerini ve mevcut durumlarını takip edin.</p>
    </div>
</div>
<div class="order-summary">

    <div class="summary-card">
        <span>Toplam Sipariş</span>
        <strong>@ViewBag.ToplamSiparis</strong>
        <small>Tüm müşteri siparişleri</small>
    </div>

    <div class="summary-card">
        <span>Bekleyen</span>
        <strong>@ViewBag.BekleyenSiparis</strong>
        <small>İşleme alınmayı bekliyor</small>
    </div>

    <div class="summary-card">
        <span>Üretimde</span>
        <strong>@ViewBag.UretimdeSiparis</strong>
        <small>Üretim sürecindeki siparişler</small>
    </div>

    <div class="summary-card">
        <span>Tamamlanan</span>
        <strong>@ViewBag.TamamlananSiparis</strong>
        <small>Tamamlanmış siparişler</small>
    </div>

</div>
<div class="order-card">

    <table class="order-table">
        <thead>
            <tr>
                <th>Sipariş No</th>
                <th>Müşteri</th>
                <th>Sipariş Tarihi</th>
                <th>Termin Tarihi</th>
                <th>Durum</th>
                <th>İşlem</th>
            </tr>
        </thead>

        <tbody>

            @if (Model != null && Model.Any())
            {
                foreach (var siparis in Model)
                {
                    <tr>
                        <td>
                            <strong>@siparis.SiparisNo</strong>
                        </td>

                        <td>@siparis.MusteriAdi</td>

                        <td>
                            @siparis.SiparisTarihi.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @if (siparis.TerminTarihi.HasValue)
                            {
                                @siparis.TerminTarihi.Value.ToString("dd.MM.yyyy")
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <td>
                            <span class="order-status">
                                @siparis.Durum
                            </span>
                        </td>
                        <td>
                            <a href="@Url.Action("Detay", "Siparis", new { id = siparis.SiparisID })"
                               class="detail-button">
                                Detay →
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="empty-message">
                        Henüz sipariş kaydı bulunmuyor.
                    </td>
                </tr>
            }

        </tbody>
    </table>

</div>
<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .page-header h2 {
        margin: 0;
        font-size: 21px;
    }

    .page-header p {
        margin: 5px 0 0;
        font-size: 11px;
        color: #8a928c;
    }

    .order-card {
        background: white;
        border-radius: 14px;
        padding: 20px;
    }

    .order-table {
        width: 100%;
        border-collapse: collapse;
    }

        .order-table th {
            text-align: left;
            padding: 11px;
            font-size: 10px;
            color: #8a928c;
            border-bottom: 1px solid #edf0ed;
        }

        .order-table td {
            padding: 14px 11px;
            font-size: 11px;
            border-bottom: 1px solid #f0f2f0;
            color: #3f4942;
        }

    .order-status {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        background: #eef5f0;
        color: #42604a;
        font-size: 9px;
        font-weight: 600;
    }

    .empty-message {
        text-align: center !important;
        padding: 30px !important;
        color: #929a94 !important;
    }
    .order-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 20px;
    }

    .summary-card {
        background: white;
        border-radius: 14px;
        padding: 18px;
    }

        .summary-card span {
            display: block;
            font-size: 10px;
            color: #8a928c;
            margin-bottom: 9px;
        }

        .summary-card strong {
            display: block;
            font-size: 22px;
            color: #26342b;
            margin-bottom: 5px;
        }

        .summary-card small {
            font-size: 9px;
            color: #a0a7a2;
        }
    .detail-button {
        display: inline-block;
        padding: 7px 11px;
        border: 1px solid #dfe8e1;
        border-radius: 8px;
        background: #f7faf8;
        color: #315c3d;
        text-decoration: none;
        font-size: 10px;
        font-weight: 600;
    }

        .detail-button:hover {
            background: #edf6ef;
            color: #174b2d;
        }
</style>