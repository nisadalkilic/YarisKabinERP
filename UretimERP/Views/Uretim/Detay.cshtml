@model IEnumerable<UretimERP.Models.UretimEmriOperasyonlari>

@{
    ViewBag.Title = "Üretim Emri Detayı";
    var uretim = ViewBag.UretimEmri as UretimERP.Models.UretimEmirleri;
}

<div class="page-header">
    <div>
        <h2>Üretim Emri Detayı</h2>
        <p>@uretim.UretimEmriNo numaralı üretim emrinin bilgileri</p>
    </div>

    <a href="@Url.Action("Index", "Uretim")" class="back-button">
        ← Üretime Dön
    </a>
</div>

<div class="production-detail">

    <div class="detail-item">
        <span>Üretim Emri</span>
        <strong>@uretim.UretimEmriNo</strong>
    </div>

    <div class="detail-item">
        <span>Ürün</span>
        <strong>@uretim.Urunler.UrunAdi</strong>
    </div>

    <div class="detail-item">
        <span>Planlanan Miktar</span>
        <strong>@uretim.PlanlananMiktar</strong>
    </div>

    <div class="detail-item">
        <span>Üretilen Miktar</span>
        <strong>@uretim.UretilenMiktar</strong>
    </div>

    <div class="detail-item">
        <span>Durum</span>
        <strong>@uretim.Durum</strong>
    </div>

</div>
@{
    decimal ilerleme = 0;

    if (uretim.PlanlananMiktar > 0)
    {
        ilerleme = (uretim.UretilenMiktar / uretim.PlanlananMiktar) * 100;
    }

    if (ilerleme > 100)
    {
        ilerleme = 100;
    }
}

<div class="progress-card">

    <div class="progress-header">
        <div>
            <span>Üretim İlerlemesi</span>
            <strong>%@Math.Round(ilerleme, 0)</strong>
        </div>

        <small>
            @uretim.UretilenMiktar / @uretim.PlanlananMiktar
        </small>
    </div>

    <div class="progress-background">
        <div class="progress-value"
             style="width: @ilerleme.ToString(System.Globalization.CultureInfo.InvariantCulture)%;">
        </div>
    </div>

</div>
<div class="operation-card">

    <div class="card-header">
        <h3>Üretim Operasyonları</h3>
        <p>Bu üretim emrine bağlı işlem adımları</p>
    </div>

    <table class="operation-table">
        <thead>
            <tr>
                <th>Operasyon</th>
                <th>Durum</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var operasyon in Model)
                {
                    <tr>
                        <td>
                            <strong>@operasyon.Operasyonlar.OperasyonAdi</strong>
                        </td>

                        <td>
                            <span class="status-badge">
                                @operasyon.Durum
                            </span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2" class="empty-message">
                        Bu üretim emrine bağlı operasyon bulunmuyor.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .page-header h2 {
            margin: 0;
            font-size: 21px;
        }

        .page-header p {
            margin: 5px 0 0;
            font-size: 11px;
            color: #8a928c;
        }

    .back-button {
        padding: 10px 14px;
        background: white;
        border: 1px solid #e4e9e5;
        border-radius: 9px;
        text-decoration: none;
        color: #315c3d;
        font-size: 11px;
    }

    .production-detail {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 15px;
        margin-bottom: 20px;
    }

    .detail-item {
        background: white;
        padding: 17px;
        border-radius: 14px;
    }

        .detail-item span {
            display: block;
            font-size: 10px;
            color: #929a94;
            margin-bottom: 7px;
        }

        .detail-item strong {
            font-size: 12px;
            color: #26342b;
        }

    .operation-card {
        background: white;
        border-radius: 14px;
        padding: 20px;
    }

    .card-header h3 {
        margin: 0;
        font-size: 15px;
    }

    .card-header p {
        margin: 5px 0 18px;
        font-size: 10px;
        color: #969d98;
    }

    .operation-table {
        width: 100%;
        border-collapse: collapse;
    }

        .operation-table th {
            text-align: left;
            padding: 11px;
            font-size: 10px;
            color: #8a928c;
            border-bottom: 1px solid #edf0ed;
        }

        .operation-table td {
            padding: 14px 11px;
            font-size: 11px;
            color: #3f4942;
            border-bottom: 1px solid #f0f2f0;
        }

    .status-badge {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        background: #eef5f0;
        color: #42604a;
        font-size: 9px;
        font-weight: 600;
    }

    .empty-message {
        text-align: center !important;
        padding: 30px !important;
        color: #929a94 !important;
    }
    .progress-card {
        background: white;
        border-radius: 14px;
        padding: 18px;
        margin-bottom: 20px;
    }

    .progress-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

        .progress-header span {
            display: block;
            font-size: 10px;
            color: #929a94;
            margin-bottom: 4px;
        }

        .progress-header strong {
            font-size: 18px;
            color: #26342b;
        }

        .progress-header small {
            font-size: 10px;
            color: #8a928c;
        }

    .progress-background {
        width: 100%;
        height: 8px;
        background: #edf1ee;
        border-radius: 20px;
        overflow: hidden;
    }

    .progress-value {
        height: 100%;
        background: #4f7659;
        border-radius: 20px;
    }
</style>