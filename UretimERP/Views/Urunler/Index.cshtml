@model IEnumerable<UretimERP.Models.Urunler>

@{
    ViewBag.Title = "Ürünler";
}

<div class="products-page">

    <div class="products-header">
        <div>
            <h2>Ürün Yönetimi</h2>
            <p>Ürün kartlarını, kategorileri ve stok sınırlarını görüntüleyin.</p>
        </div>

        <a href="@Url.Action("Create", "Urunler")" class="new-product-button">
            + Yeni Ürün
        </a>
    </div>

    <div class="product-stats">

        <div class="product-stat">
            <span>Toplam Ürün</span>
            <strong>@ViewBag.ToplamUrun</strong>
        </div>

        <div class="product-stat">
            <span>Aktif Ürün</span>
            <strong>@ViewBag.AktifUrun</strong>
        </div>

        <div class="product-stat">
            <span>Pasif Ürün</span>
            <strong>@ViewBag.PasifUrun</strong>
        </div>

        <div class="product-stat">
            <span>Bulunan</span>
            <strong>@ViewBag.BulunanUrun</strong>
        </div>

    </div>

    <div class="product-card">

        <div class="product-toolbar">

            @using (Html.BeginForm("Index", "Urunler", FormMethod.Get))
            {
                <div class="product-search">

                    <input type="text"
                           name="ara"
                           value="@ViewBag.Ara"
                           placeholder="Ürün kodu veya ürün adı ara..." />

                    <button type="submit">
                        Ara
                    </button>

                    @if (!string.IsNullOrWhiteSpace(ViewBag.Ara as string))
                    {
                        <a href="@Url.Action("Index", "Urunler")">
                            Temizle
                        </a>
                    }

                </div>
            }

        </div>

        <div class="product-table-wrapper">

            <table class="product-table">

                <thead>
                    <tr>
                        <th>Ürün Kodu</th>
                        <th>Ürün Adı</th>
                        <th>Kategori</th>
                        <th>Ürün Tipi</th>
                        <th>Birim</th>
                        <th>Min. Stok</th>
                        <th>Durum</th>
                        <th>İşlem</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var urun in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@urun.UrunKodu</strong>
                                </td>

                                <td>@urun.UrunAdi</td>

                                <td>
                                    @(urun.Kategoriler != null
                                        ? urun.Kategoriler.KategoriAdi
                                        : "-")
                                </td>

                                <td>
                                    @(urun.UrunTipleri != null
                                        ? urun.UrunTipleri.TipAdi
                                        : "-")
                                </td>

                                <td>
                                    @(urun.Birimler != null
                                        ? urun.Birimler.BirimAdi
                                        : "-")
                                </td>

                                <td>
                                    @urun.MinimumStok.ToString("N2")
                                </td>

                                <td>
                                    @if (urun.AktifMi)
                                    {
                                        <span class="product-status active-product">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="product-status passive-product">
                                            Pasif
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="product-actions">

                                        <a href="@Url.Action("Details", "Urunler", new { id = urun.UrunID })">
                                            Detay
                                        </a>

                                        <a href="@Url.Action("Edit", "Urunler", new { id = urun.UrunID })">
                                            Düzenle
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="empty-products">
                                Arama kriterlerine uygun ürün bulunamadı.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

    .products-page {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .products-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

        .products-header h2 {
            margin: 0;
            font-size: 26px;
            color: #1f2937;
        }

        .products-header p {
            margin: 6px 0 0;
            font-size: 14px;
            color: #6b7280;
        }

    .new-product-button {
        padding: 10px 14px;
        border-radius: 9px;
        background: #166534;
        color: #ffffff;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

        .new-product-button:hover {
            background: #14532d;
            color: #ffffff;
            text-decoration: none;
        }

    .product-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
    }

    .product-stat {
        padding: 17px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 13px;
    }

        .product-stat span {
            display: block;
            margin-bottom: 7px;
            color: #6b7280;
            font-size: 12px;
        }

        .product-stat strong {
            color: #111827;
            font-size: 23px;
        }

    .product-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
    }

    .product-toolbar {
        padding: 17px 20px;
        border-bottom: 1px solid #e5e7eb;
    }

    .product-search {
        display: flex;
        gap: 8px;
        max-width: 650px;
    }

        .product-search input {
            flex: 1;
            padding: 9px 12px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            outline: none;
            font-size: 13px;
        }

            .product-search input:focus {
                border-color: #16a34a;
            }

        .product-search button,
        .product-search a {
            padding: 9px 14px;
            border-radius: 8px;
            font-size: 12px;
            text-decoration: none;
        }

        .product-search button {
            border: none;
            background: #166534;
            color: #ffffff;
            cursor: pointer;
        }

        .product-search a {
            border: 1px solid #d1d5db;
            color: #4b5563;
            background: #ffffff;
        }

    .product-table-wrapper {
        overflow-x: auto;
    }

    .product-table {
        width: 100%;
        border-collapse: collapse;
    }

        .product-table th {
            padding: 13px 15px;
            text-align: left;
            background: #f9fafb;
            color: #6b7280;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .product-table td {
            padding: 14px 15px;
            border-top: 1px solid #f3f4f6;
            color: #4b5563;
            font-size: 13px;
        }

            .product-table td strong {
                color: #1f2937;
            }

    .product-status {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .active-product {
        background: #ecfdf5;
        color: #047857;
    }

    .passive-product {
        background: #f3f4f6;
        color: #6b7280;
    }

    .product-actions {
        display: flex;
        gap: 7px;
    }

        .product-actions a {
            padding: 6px 9px;
            border: 1px solid #e5e7eb;
            border-radius: 7px;
            color: #166534;
            text-decoration: none;
            font-size: 11px;
            white-space: nowrap;
        }

            .product-actions a:hover {
                background: #f0fdf4;
                text-decoration: none;
            }

    .empty-products {
        padding: 40px !important;
        text-align: center;
        color: #9ca3af !important;
    }

    @@media (max-width: 900px) {

        .product-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .products-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>